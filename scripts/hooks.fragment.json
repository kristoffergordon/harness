{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 {{HOOKS}}/guard_bash.py" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "{{HOOKS}}/verify-turn.sh snapshot" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "{{HOOKS}}/verify-turn.sh" }]
      }
    ]
  }
}
